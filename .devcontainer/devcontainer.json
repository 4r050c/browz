{
  "name": "browser-sandbox",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postStartCommand": "docker run -d --name chrome-sandbox --shm-size=2gb -p 7900:7900 selenium/standalone-chrome-debug",
  "forwardPorts": [7900],
  "portsAttributes": {
    "7900": { "label": "Browser Sandbox (noVNC)", "visibility": "public" }
  }
}
